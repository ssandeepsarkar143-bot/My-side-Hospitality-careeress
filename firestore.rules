rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() { return request.auth != null; }
    function isOwner() { return isSignedIn() && request.auth.token.email == 'ssandeepsarkar143@gmail.com'; }
    function isSelf(uid) { return isSignedIn() && request.auth.uid == uid; }

    // USERS — read self + minimal public list, write self (owner full)
    match /users/{uid} {
      allow read: if isSignedIn();
      allow create: if isSelf(uid);
      allow update: if isSelf(uid) || isOwner();
      allow delete: if isOwner();
    }

    // SITE SETTINGS — public read, owner write
    match /siteContent/{doc} {
      allow read: if true;
      allow write: if isOwner();
    }

    // JOBS — public read, signed-in create, owner full
    match /jobPosts/{id} {
      allow read: if true;
      allow create, update: if isSignedIn();
      allow delete: if isOwner();
    }

    // APPLICATIONS — owner full, user manage own
    match /applications/{id} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update, delete: if isOwner() || (isSignedIn() && resource.data.userId == request.auth.uid);
    }

    // REQUESTS (membership / connect / contact / resume / wallet-pay)
    match /requests/{id} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isOwner() || isSignedIn();
      allow delete: if isOwner();
    }

    // WALLET TOP-UPS — user creates own, owner approves
    match /walletTopups/{id} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.uid == request.auth.uid;
      allow update, delete: if isOwner();
    }

    // WALLET TRANSACTIONS — append-only ledger
    match /walletTransactions/{id} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update, delete: if isOwner();
    }

    // REFERRAL REWARDS log
    match /referralRewards/{id} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update, delete: if isOwner();
    }

    // WALLET WITHDRAWALS — user creates own (after debit), owner approves/rejects
    match /walletWithdrawals/{id} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.uid == request.auth.uid;
      allow update, delete: if isOwner();
    }

    // ENQUIRIES — user creates own, owner reads/replies/resolves
    match /enquiries/{id} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.uid == request.auth.uid;
      allow update, delete: if isOwner();
    }

    // COUPONS — owner creates per-user, user claims own
    match /coupons/{id} {
      allow read: if isSignedIn();
      allow create: if isOwner();
      allow update: if isOwner() || (isSignedIn() && resource.data.targetUid == request.auth.uid);
      allow delete: if isOwner();
    }

    // ACTIVITY RECORDS — global success/fail log (any signed-in user can append; owner-only read)
    match /activityRecords/{id} {
      allow read: if isOwner();
      allow create: if isSignedIn();
      allow update, delete: if isOwner();
    }

    // FROZEN USERS — owner controlled freeze table
    match /frozenUsers/{uid} {
      allow read: if isSignedIn();
      allow write: if isOwner();
    }

    // CHAT GROUP ADMINS — per-group sub-admins set by owner
    match /chatGroupAdmins/{id} {
      allow read: if isSignedIn();
      allow write: if isOwner();
    }

    // OFFERS / UPGRADES / MPINS / NOTIFICATIONS / FEEDBACK
    match /offers/{id}     { allow read: if true; allow write: if isOwner(); }
    match /upgrades/{id}   { allow read: if isSignedIn(); allow write: if isOwner(); }
    // MPINS — Phase 7: self can manage own; Owner/OpMgr/BranchHead can manage any
    match /mpins/{id} {
      function isMgmt() {
        return isSignedIn() &&
          exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
          (
            get(/databases/$(database)/documents/users/$(request.auth.uid)).data.adminRole == 'Operations Manager' ||
            get(/databases/$(database)/documents/users/$(request.auth.uid)).data.adminRole == 'Branch Head'
          );
      }
      allow read, write: if isOwner() || isSelf(id) || isMgmt();
    }

    // PREVIEW LOG (Phase 7) — owner creates/updates; any signed-in can read for transparency
    match /previewLog/{id} {
      allow read: if isSignedIn();
      allow create, update: if isOwner() || isSignedIn();
      allow delete: if isOwner();
    }
    match /notifications/{id} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update, delete: if isOwner() || (isSignedIn() && resource.data.userId == request.auth.uid);
    }
    match /feedback/{id} {
      allow read: if true;
      allow create: if isSignedIn();
      allow update, delete: if isOwner();
    }

    // AUDIT LOG (Phase 1) — append-only by signed-in users; owner full
    match /auditLog/{id} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update, delete: if isOwner();
    }

    // CONNECT HUB GROUPS (Phase 4) — owner manages; members read/write own group
    match /connectGroups/{groupId} {
      allow read: if isSignedIn() && (
        isOwner() ||
        request.auth.uid in resource.data.memberUids
      );
      allow create: if isOwner();
      allow update: if isOwner() ||
        (isSignedIn() && request.auth.uid in resource.data.memberUids
          && request.resource.data.memberUids == resource.data.memberUids
          && request.resource.data.ownerUid == resource.data.ownerUid);
      allow delete: if isOwner();

      // MESSAGES — only group members can read/post; updates only for read receipts
      match /messages/{msgId} {
        allow read: if isSignedIn() && (
          isOwner() ||
          request.auth.uid in get(/databases/$(database)/documents/connectGroups/$(groupId)).data.memberUids
        );
        allow create: if isSignedIn() && (
          isOwner() ||
          request.auth.uid in get(/databases/$(database)/documents/connectGroups/$(groupId)).data.memberUids
        );
        // Members can update only the readBy list (mark themselves as read)
        allow update: if isSignedIn() && (
          isOwner() ||
          (request.auth.uid in get(/databases/$(database)/documents/connectGroups/$(groupId)).data.memberUids
            && request.resource.data.diff(resource.data).changedKeys().hasOnly(['readBy']))
        );
        allow delete: if isOwner();
      }
    }

    // PRESENCE (Phase 8) — anyone can write/read own presence; signed-in can read all
    match /presence/{uid} {
      allow read: if isSignedIn();
      allow write: if isSelf(uid);
    }

    // CHAT REPORTS (Phase 8) — owner only
    match /chatReports/{id} {
      allow read, write: if isOwner();
    }

    // USER CREDENTIALS (Phase 8) — owner-only Email/Password issuance ledger
    match /userCredentials/{uid} {
      allow read, write: if isOwner();
    }

    // MPIN REMINDER CONFIG (Phase 8)
    match /mpinReminderConfig/{id} {
      allow read: if isSignedIn();
      allow write: if isOwner();
    }
  }
}
