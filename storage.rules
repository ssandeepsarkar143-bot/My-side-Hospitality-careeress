rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Chat uploads — any signed-in user can upload, anyone can read (URLs are unguessable)
    match /chatUploads/{groupId}/{file=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    // Chat reports — anyone signed-in can read; owner writes
    match /chatReports/{groupId}/{file=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    // Default — read public, write signed-in
    match /{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }
  }
}
